motif 1
// Сжатие и растяжение: у мяча только ключи прыжков, форму считает squash.
// В полёте мяч вытягивается по ходу, при ударе о пол сплющивается и вздрагивает.
// На полу мяч стоит пару кадров (hold): удар останавливает его, и squash превращает это в сплющивание.
// Ось (pivot) внизу мяча: он сплющивается о пол, а не висит в воздухе.
artboard "Сжатие" 480x320 bg #1b2030

let ink = #10131d

rect floor "Пол" at 240 300 size 480 40 fill #283049

ellipse ball "Мяч" at 60 80 size 50 50 pivot 0 25 fill #ff7a59 stroke ink 4 squash 0.6 6 0.3

anim Bounce 2.4s loop id=mbya {
  ball.x 0: 60 | 2.4: 420
  ball.y 0: 80 ease-in | 0.5: 255 hold | 0.58: 255 ease-out | 1.05: 120 ease-in | 1.5: 255 hold | 1.58: 255 ease-out | 1.9: 170 ease-in | 2.2: 255 | 2.4: 255
}
