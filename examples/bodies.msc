// 3D-тела: плоская фигура выдавливается в глубину (extrude глубина [сужение]) и поворачивается
// в пространстве ключами yaw (влево-вправо) и pitch (наклон). Рисуется векторными гранями:
// задние скрыты, остальные освещены светом сцены (light), обводка — только по настоящим рёбрам.
artboard "3D-тела" 640x360 bg #1d2233 light 60

let ink = #10131d

rect cube "Куб" at 110 120 size 90 90 fill #ff7a59 stroke ink 4 extrude 90 yaw 30 pitch 25
ellipse can "Цилиндр" at 260 120 size 80 80 fill #5ee0a0 stroke ink 4 extrude 110 pitch -70
ellipse cone "Конус" at 400 120 size 90 90 fill #ffd23f stroke ink 4 extrude 120 0 pitch -100
polygon prism "Призма" at 540 120 size 90 80 points 3 fill #6c8cff stroke ink 4 extrude 120 yaw 60 pitch 20

// Любой контур: звезда-печенье, пирамида, слово.
star cookie "Звезда" at 110 270 size 100 100 points 5 inner 0.5 r 6 fill #ff5c8a stroke ink 4 extrude 26 yaw -30 pitch 35
polygon pyramid "Пирамида" at 260 275 size 110 110 points 4 fill #c89bff stroke ink 4 extrude 90 0 pitch -70 yaw 20
path coin "Монета" at 400 270 d "M 0 -45 C 25 -45 45 -25 45 0 C 45 25 25 45 0 45 C -25 45 -45 25 -45 0 C -45 -25 -25 -45 0 -45 Z M 0 -18 L 6 -6 L 18 -4 L 9 5 L 11 18 L 0 12 L -11 18 L -9 5 L -18 -4 L -6 -6 Z" fill #ffc94a stroke ink 4 extrude 14
path ribbon "Лента" at 545 270 d "M -60 0 C -30 -50 30 50 60 0" fill #5ee0a0 stroke ink 4 extrude 50 pitch 50

anim Spin 4s loop {
  cube.yaw     0: 30 linear | 4: 390
  can.pitch    0: -70 ease-in-out-sine | 2: -20 ease-in-out-sine | 4: -70
  cone.yaw     0: 0 linear | 4: 360
  prism.yaw    0: 60 linear | 4: 420
  cookie.yaw   0: -30 ease-in-out-sine | 2: 30 ease-in-out-sine | 4: -30
  pyramid.yaw  0: 20 linear | 4: 380
  coin.yaw     0: 0 linear | 4: 360
  ribbon.yaw   0: 0 linear | 4: 360
}
