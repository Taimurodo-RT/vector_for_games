motif 1
// @motif-web {"tokens":{"ink":"currentColor","accent":"--icon-accent","panel":"--panel"},"themes":{"dark":{"ink":"#eee8db","accent":"#a5c77e","panel":"#414a3c"}},"assets":{"ui-leaf.24":{"id":"ui-leaf","file":"icons/ui-leaf.24.svg","profile":"icon24","variant":"default","stage":"example","keywords":["leaf","nature"],"pivot":[12,12],"layers":{"leaf":{"class":"base anim-leaf"}}},"ui-panel":{"id":"ui-panel","file":"nodes/ui-panel.svg","profile":"general","slices":[8,8,8,8],"layers":{"panel":{"class":"base"}}},"ui-tile":{"id":"ui-tile","file":"world/ui-tile.svg","profile":"tile"}}}
let ink = #2b2620
let accent = #628f47
let panel = #ebe3d2

artboard "ui-leaf.24" 24x24 bg #f6f1e7 ui
group leaf at 12 12 {
  path body d "M -8 8 Q -9 -8 8 -8 Q 8 8 -8 8 Z" fill accent stroke ink 1.75
  path vein d "M -8 8 L 3 -3" fill none stroke ink 1.75
}
anim Sway 1s loop id=hye3 {
  leaf.rot 0: -5 ease-in-out | 0.5: 5 ease-in-out | 1: -5
}

artboard "ui-panel" 96x48 bg #f6f1e7 ui cell 1 0
rect panel at 48 24 size 92 44 r 6 fill panel stroke ink 1.5

artboard "ui-tile" 32x32 bg #f6f1e7 game cell 2 0
rect ground at 16 16 size 32 fill accent
path grass d "M 7 10 L 9 6 L 11 10 M 22 25 L 24 21 L 26 25" fill none stroke ink 1.5 opacity 0.4
