motif 1
// Мяч, звезда и кнопка: пример сцены Motif.
// Правьте текст — холст обновится сразу. Двигайте объекты мышью — числа поменяются здесь.
artboard "Главный" 480x360 bg #fff4e4

let ink = #1b1d24
let red = #ff5a36

rect    floor "Пол"     at 240 324  size 400 6   r 3  fill #2a2e39
ellipse shadow "Тень"   at 150 318  size 60 12   fill ink  opacity 0.16
ellipse ball "Мяч"      at 150 150  size 72      fill red  stroke ink 4
star    star "Звезда"   at 340 150  size 130     points 5  fill #ffc531  stroke ink 4
rect    badge "Кнопка"  at 340 286  size 150 44  r 22  fill #3b5bff

group coins "Монеты" at 36 40 {
  for i in 0..5 {
    ellipse coin{i} at {i * 28} 0 size 16 fill #ffd23f stroke ink 2
  }
}

anim Idle 1.2s loop id=twqs {
  ball.y         0: 120 ease-in | 0.6: 278 ease-out | 1.2: 120
  ball.h         0: 76 linear | 0.55: 76 ease-out | 0.6: 58 ease-out | 0.7: 74
  ball.w         0: 70 linear | 0.55: 70 ease-out | 0.6: 86 ease-out | 0.7: 72
  shadow.w       0: 36 ease-in | 0.6: 86 ease-out | 1.2: 36
  shadow.opacity 0: 0.06 ease-in | 0.6: 0.24 ease-out | 1.2: 0.06
  star.rot       0: 0 linear | 1.2: 72
}

anim Hover 0.8s loop id=v54r {
  star.w    0: 130 | 0.4: 152 | 0.8: 130
  star.h    0: 130 | 0.4: 152 | 0.8: 130
  star.fill 0: #ffc531 | 0.4: #ff8a3d | 0.8: #ffc531
  badge.w   0: 150 | 0.4: 172 | 0.8: 150
}
