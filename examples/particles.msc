// Частицы: фигура становится источником (emit), её копии вылетают, падают, крутятся и гаснут.
// Костёр: искры летят вверх и гаснут, дым растёт и тает. Комета: источник едет по ключам
// и оставляет хвост. Залп звёздочек (burst) вылетает при старте.
artboard "Частицы" 520x320 bg #141826

let ink = #0d1018

rect ground "Земля" at 260 300 size 520 40 fill #232a3d

// Костёр: поленья и два источника над ними.
rect log1 at 130 270 size 90 14 r 7 rot 12 fill #6b4a2f stroke ink 3
rect log2 at 130 270 size 90 14 r 7 rot -12 fill #7a5534 stroke ink 3
ellipse smoke "Дым" at 130 240 size 18 18 fill #8b93a8 opacity 0.5 emit 6 life 2.5 speed 40 spread 30 drag 0.3 grow 3.5 fade 0
ellipse spark "Искры" at 130 255 size 6 6 fill #ffb347 emit 40 life 1 speed 160 spread 50 gravity -60 drag 0.5 grow 0.2 fade 0

// Комета: едет по дуге, хвост остаётся позади.
ellipse comet "Комета" at 60 80 size 10 10 fill #9fe8ff emit 80 life 0.6 speed 20 spread 360 grow 0 fade 0

// Залп: звёздочки разлетаются при старте и падают.
star burst "Залп" at 380 200 size 14 14 points 5 inner 0.45 fill #ffd23f stroke ink 2 emit 0 burst 24 life 2.5 speed 260 angle -90 spread 120 gravity 500 spin 360 fade 0.3

anim Night 3s loop {
  comet.x 0: 60 ease-in-out | 3: 470
  comet.y 0: 80 ease-out | 1.5: 40 ease-in | 3: 110
}
