motif 2
// Сцена для точного рисования: на ней проверяются привязки, рамка и узлы.
// Попробуйте: R и тяните от угла панели — новая фигура встанет край в край;
// P и щёлкайте у узлов звезды — точки сядут точно на них (розовый ромб).
// Голубые линии — направляющие: тяните новые из линеек, а к этим подводите объекты.
// Рамка: тяните ручки панели и повёрнутой группы — противоположная сторона стоит на месте;
// выделите несколько объектов (Shift+клик) — рамка станет общей.
// Кружок с крестиком в рамке — опорная точка: нажмите Y, перетащите её на угол и поверните объект.
let ink = #1b1d24
let paper = #f4f1ff
artboard "Точность" 640x400 bg paper ui
guide x 320
guide y 200

// Панель из прямоугольников: края и центры для направляющих.
rect panel "Панель" at 150 110 size 220 140 r 12 fill #ffffff stroke ink 2
rect title "Заголовок" at 150 62 size 196 28 r 6 fill #6f93ff
rect slot_a "Ячейка A" at 84 126 size 64 64 r 8 fill #e8ecf7 stroke ink 1
rect slot_b "Ячейка B" at 150 126 size 64 64 r 8 fill #e8ecf7 stroke ink 1

// Контур с узлами и кольцо с двумя отверстиями. Enter на кольце — правка точек:
// рамка берёт узлы обоих отверстий, и они двигаются вместе. У выделенных узлов своя рамка
// с тёмными ручками: она растягивает и поворачивает их, а кнопки в панели выравнивают.
star mark "Звезда" at 400 110 size 120 120 points 5 inner 0.45 fill #ffd23f stroke ink 2
path ring "Кольцо" at 540 110 d "M -50 0 C -50 -28 -28 -50 0 -50 C 28 -50 50 -28 50 0 C 50 28 28 50 0 50 C -28 50 -50 28 -50 0 Z M -30 -8 L -6 -8 L -6 16 L -30 16 Z M 8 -20 L 30 -20 L 30 4 L 8 4 Z" evenodd fill #4fd38c stroke ink 2

// Вложенные группы: поворот, отражение и отрицательный масштаб.
group turned "Повёрнутая" at 150 300 rot 20 {
  rect turned_box size 120 60 r 6 fill #ff8a5c stroke ink 2
  group turned_inner at 30 0 scale 0.5 {
    ellipse turned_dot size 40 40 fill ink
  }
}
group mirrored "Отражённая" at 400 300 scale -1 1 {
  path flag d "M -50 -30 L 50 -30 L 20 0 L 50 30 L -50 30 Z" fill #c58cff stroke ink 2
  rect flag_pole at -56 0 size 8 90 fill ink
}
group flipped "Перевёрнутая" at 540 300 scale 0.8 -1.2 skew 10 {
  polygon tri size 90 80 points 3 fill #7bd389 stroke ink 2
}
