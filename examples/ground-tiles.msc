path pad2 at 64 12 d "M 0 0 L 8 -3 C 7 -8 -2 -9 -6 -5 C -10 -1 -8 6 -2 7 C 3 9 8 6 8 2 Z" rot 140 fill #6fae5f stroke ink 1.5 join round

