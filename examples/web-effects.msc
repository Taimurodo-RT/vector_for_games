motif 1
// @motif-web {"tokens":{"accent":"--accent","ink":"currentColor"},"themes":{"night":{"accent":"#98c4ff","ink":"#c9dbf0"},"warm":{"accent":"#edaa65","ink":"#633e2c"}},"assets":{"web-effects":{"file":"effects.svg","stage":"example","keywords":["effects","vector"],"layers":{"shadow":{"class":"base"}}},"web-color":{"file":"color.svg"},"web-reveal":{"file":"reveal.svg"}}}
let accent = #6c9ee8
let ink = #294563

artboard "web-effects" 560x300 bg #eef1f6 ui
rect background at 280 150 size 560 300 r 16 fill #eef1f6
text heading at 280 32 content "ВЕКТОРНЫЕ ЭФФЕКТЫ" font bold font-size 20 fill ink
rect shadow at 100 105 size 110 56 r 14 fill accent shadow 6 8 12 #182b4b55
rect glow at 280 105 size 100 48 r 14 fill #203353 stroke accent 3 glow 12 3 #70a8fbaa
rect inset at 460 105 size 110 56 r 14 fill accent inset 0 5 8 #14294499
text l1 at 55 162 content "Тень" font-size 14 fill ink
text l2 at 235 162 content "Свечение" font-size 14 fill ink
text l3 at 410 162 content "Внутренняя тень" font-size 14 fill ink
ellipse sticker at 100 224 size 66 48 fill accent outline #294563 12 #ffffff 7
rect hatch at 280 224 size 100 52 r 8 fill accent rough 1.5 12 hatch 45 6 1.2 #294563 cross
group soft at 460 224 scale 1.2 0.7 rot 15 blur 5 clip {
  ellipse mask size 86 70
  rect warm at -18 0 size 70 fill #edaa65
  ellipse cool at 18 0 size 70 fill accent
}
text l4 at 55 280 content "Обводки" font-size 14 fill ink
text l5 at 235 280 content "Штриховка" font-size 14 fill ink
text l6 at 410 280 content "Маска + blur" font-size 14 fill ink

artboard "web-color" 96x96 bg #eef1f6 ui cell 1 0
ellipse color at 48 48 size 60 fill #6c9ee8 stroke #294563 3
anim Color 2s loop id=kqrb {
  color.fill 0: #6c9ee8 | 1: #edaa65 | 2: #6c9ee8
  color.stroke 0: #294563 | 1: #633e2c | 2: #294563
  color.stroke_w 0: 3 | 1: 7 | 2: 3
}

artboard "web-reveal" 160x120 bg #eef1f6 ui cell 2 0
rect reveal at 70 60 size 80 48 r 14 fill accent opacity 0 shadow 5 7 10 #182b4b88
anim Reveal 2s loop id=y5fj {
  reveal.opacity 0: 0 ease-in-out | 0.7: 1 | 1.3: 1 ease-in-out | 2: 0
  reveal.x 0: 60 ease-in-out | 1: 90 ease-in-out | 2: 60
}
