// Процедурные кисти: тот же вектор, но как будто нарисован рукой.
// rough — контур гуляет (сила, длина волны), boil — линия перерисовывается N раз в секунду,
// hatch — штриховка (угол, шаг, толщина, цвет, cross), grain — зерно (доля, размер, цвет),
// bands — градиенты и свет на 3D-телах ступенями, seed — другой рисунок той же кисти.
artboard "Кисти" 640x360 bg #f3ead8 light 60

let ink = #2a2230

rect sky "Небо" at 320 110 size 640 220 gradient linear 90 #8fc5e8 #f6d7a7 bands 5
ellipse sun "Солнце" at 520 80 size 90 90 gradient radial #fff3b0 #ffc35a #ff8a3d bands 3 rough 1.5 30
rect ground "Земля" at 320 290 size 680 160 fill #9bbf6a stroke ink 3 rough 3 60 grain 0.12 2.5

// Скала: тень заштрихована внутри её силуэта (маска с тем же seed), контур — поверх штриховки.
polygon rock "Скала" at 150 215 size 170 120 points 5 fill #b9b2a6 rough 3 seed 5 rot 8
group rockshade "Тень скалы" clip {
  polygon rockmask at 150 215 size 170 120 points 5 fill #000000 rough 3 seed 5 rot 8
  path shade at 205 245 d "M -60 -70 L 60 -60 L 60 40 L -90 40 Z" rough 2 hatch 60 6 1.4 #5b5363 cross
}
polygon rockline "Контур скалы" at 150 215 size 170 120 points 5 fill none stroke ink 3 rough 3 seed 5 rot 8

// Куст из трёх кругов, у каждого свой seed.
ellipse bush1 "Куст" at 330 222 size 80 70 fill #5f9a4a stroke ink 3 rough 3 22 seed 1 hatch -30 7 1.4 #3f6d36
ellipse bush2 "Куст 2" at 380 210 size 90 84 fill #6cab52 stroke ink 3 rough 3 22 seed 2
ellipse bush3 "Куст 3" at 425 226 size 70 60 fill #5f9a4a stroke ink 3 rough 3 22 seed 3

// Ящик: 3D-тело со светом в три ступени.
rect crate "Ящик" at 540 235 size 70 70 fill #d08a4a stroke ink 3 extrude 70 yaw 30 pitch 20 bands 3

// Слизень: линия «дрожит», как в рисованной анимации.
ellipse slime "Слизень" at 250 300 size 90 56 fill #8fd6ff stroke ink 3 rough 2.5 18 boil 8 grain 0.08 3 #ffffff
ellipse eye "Глаз" at 268 292 size 12 16 fill ink rough 0.8 10 boil 8

anim Wobble 2s loop {
  slime.sx  0: 1 ease-in-out-sine | 1: 1.12 ease-in-out-sine | 2: 1
  slime.sy  0: 1 ease-in-out-sine | 1: 0.88 ease-in-out-sine | 2: 1
  crate.yaw 0: 30 linear | 2: 120
}
