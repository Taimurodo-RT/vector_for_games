// Таймер фокуса (помидор): 25 минут работы, 5 — отдыха. Интерфейс нарисован здесь целиком,
// ../build.sh (или build.bat) делает из холста ui/focus_screen.tscn командой motif screen:
// кнопки — Button, полоса — ProgressBar, ползунок минут — HSlider, флажок — CheckBox,
// всё с темой ui/focus.tres. Логика — в main.gd: она находит узлы по id отсюда.
artboard "focus" 380x640 bg #0e1320 ui

let card = #172034
let well = #0b1019
let edge = #26314c
let chip = #222c44
let accent = #ff6b5a
let warm = #ffb199
let ink = #f2f4fa
let dim = #8590aa

group app "Приложение" anchor center middle stack column center gap 18 pad 26 {
  rect panel "Карточка" r 30 fill card stroke edge 2 fit shadow 0 18 36 #00000099 noise 0.035
  text title "Заголовок" content "ФОКУС" font bold font-size 16 letter-spacing 6 fill dim

  // Режим: две одинаковые «таблетки», выбранная — в состоянии Press (в Godot это нажатая кнопка-переключатель).
  group modes "Режимы" stack row gap 8 {
    group work "Работа" ui button {
      rect work-face size 132 40 r 20 fill chip stroke edge 2
      text work-label content "Работа" font bold font-size 16 fill ink part text
    }
    group rest "Отдых" ui button {
      rect rest-face size 132 40 r 20 fill chip stroke edge 2
      text rest-label content "Отдых" font bold font-size 16 fill ink part text
    }
  }

  group clock "Циферблат" stack column center gap 0 pad 22 {
    rect dial "Экран" r 26 fill well stroke #1a2236 2 fit inset 0 6 14 #000000cc
    text time "Время" content "25:00" font bold font-size 76 fill ink
    text phase "Подпись" content "до отдыха" font-size 16 fill dim
  }

  group progress "Прогресс" ui progress {
    rect bar-back size 300 16 r 8 fill well stroke edge 2 slice 8 part background
    rect bar-fill at -40 0 size 212 10 r 5 fill accent gradient linear 0 #ff8a5c #ff5a7a glow 6 #ff6b5a88 slice 5 part fill
  }

  group buttons "Кнопки" stack row gap 12 {
    group start "Старт" ui button {
      rect start-face size 176 54 r 27 fill accent stroke #ff9a8c 2 gradient linear 90 #ff8a6c #ff5a5a glow 10 #ff6b5a66
      text start-label content "Старт" font bold font-size 20 fill #2a0b07 part text
    }
    group reset "Сброс" ui button {
      rect reset-face size 112 54 r 27 fill chip stroke edge 2
      text reset-label content "Сброс" font bold font-size 18 fill ink part text
    }
  }

  group minutes-row "Минуты" stack row center gap 12 {
    text minutes-title "Подпись" content "Работа, мин" font-size 15 fill dim
    group minutes "Ползунок" ui slider {
      rect rail size 130 8 r 4 fill well stroke edge 2 slice 4 part track
      rect level at -32 0 size 66 8 r 4 fill accent slice 4 part fill
      ellipse knob size 22 22 fill ink stroke #0b1019 3 part grabber
    }
    text minutes-value "Значение" content "25" font bold font-size 18 fill ink
  }

  group auto "Сам начинать отдых" ui check {
    rect auto-off at -96 0 size 26 26 r 8 fill well stroke edge 2 part unchecked
    group auto-on at -96 0 part checked {
      rect auto-box size 26 26 r 8 fill accent stroke #ff9a8c 2
      path auto-tick d "M -6 0 L -2 5 L 7 -5" fill none stroke #2a0b07 3 cap round join round
    }
    text auto-label at -72 0 content "Отдых начинается сам" font-size 15 fill ink align left part text
  }
}

anim Hover 0.15s {
  work-face.fill    0: #222c44 | 0.15: #2b3754
  start-face.glow   0: 10 | 0.15: 20
  reset-face.fill   0: #222c44 | 0.15: #2b3754
  level.fill        0: #ff6b5a | 0.15: #ff8a7c
  knob.fill         0: #f2f4fa | 0.15: #ffffff
}

anim Press 0.08s {
  work-face.fill    0: #222c44 | 0.08: #ff6b5a
  work-face.stroke  0: #26314c | 0.08: #ff9a8c
  work-label.fill   0: #f2f4fa | 0.08: #2a0b07
  start-face.glow   0: 10 | 0.08: 26
  reset-face.fill   0: #222c44 | 0.08: #1a2236
}
